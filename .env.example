# NyaNya Agent runtime configuration.
# Copy this file to .env and fill only the values you need.
# npm installs keep this file under NYANYA_HOME, outside the npm package.
# Relative mutable paths (data, logs, sessions, config) resolve from NYANYA_HOME.
# Set NYANYA_HOME in the shell or service environment, not inside this file.

NYANYA_PROVIDER=gemini_cli
NYANYA_MODEL=antigravity-cli-default
NYANYA_TEMPERATURE=0.3
NYANYA_TIMEOUT_SECONDS=180
NYANYA_SAVE_TRANSCRIPTS=true
NYANYA_SYSTEM_PROMPT_PATH=prompts/system.md
NYANYA_SESSIONS_DIR=sessions

# Gemini-compatible CLI. Examples:
# NYANYA_GEMINI_CLI=gemini
# NYANYA_GEMINI_CLI=/opt/homebrew/bin/agy
NYANYA_GEMINI_CLI=gemini
NYANYA_GEMINI_MODEL=
NYANYA_GEMINI_APPROVAL_MODE=plan
NYANYA_ANTIGRAVITY_SANDBOX=true

# Ollama/OpenAI-compatible fallback endpoints.
NYANYA_OLLAMA_MODEL=qwen3:4b
NYANYA_OLLAMA_BASE_URL=http://127.0.0.1:11434
NYANYA_OPENAI_BASE_URL=http://127.0.0.1:8000
NYANYA_OPENAI_API_KEY=

# Workspace policy. Keep this narrow for shared installs.
NYANYA_WORKSPACE_ROOT=
NYANYA_WORKSPACE_ROOTS=
NYANYA_TRUSTED_WORKSPACE_ROOTS=
NYANYA_CODEX_WORKDIR=
NYANYA_USER_WORKSPACES_FILE=config/user_workspaces.json
NYANYA_PROTECTED_DELETE_PATHS=

# Codex availability/independent service controls. Normal operations use fixed routing profiles.
NYANYA_CODEX_ENABLED=false
NYANYA_CODEX_CLI=codex
# Successful task work records: bounded, private, no additional LLM call.
NYANYA_WORK_MEMORY_ENABLED=true
# Legacy approved candidate retrieval/refinement (separate from work records).
NYANYA_MEMORY_RETRIEVAL_ENABLED=true
NYANYA_MEMORY_RETRIEVAL_LIMIT=5
NYANYA_MEMORY_CONTEXT_MAX_CHARS=1800
NYANYA_MEMORY_WORKER_INTERVAL_SECONDS=1800
NYANYA_MEMORY_WORKER_SCAN_LIMIT=50
NYANYA_MEMORY_WORKER_LLM_REFINEMENT=false
NYANYA_MEMORY_WORKER_LLM_MIN_IMPORTANCE=75

# Messenger access control.
NYANYA_ALLOW_UNLISTED=false
NYANYA_OWNER_USER_IDS=
NYANYA_TASK_QUEUE_MAX=2

# macOS LaunchAgent labels. Keep the default for normal installs.
# For isolated install tests, override this in the shell or .env so test
# commands stop only their own test services.
NYANYA_SERVICE_LABEL_PREFIX=com.hcs.nyanya

# Discord bridge.
# If this token is empty, Discord bridge features are unavailable until
# you configure the token and allowed channels/users later.
NYANYA_DISCORD_BOT_TOKEN=
NYANYA_DISCORD_PREFIX=!nyanya
NYANYA_DISCORD_RESPOND_IN_ALLOWED_CHANNELS=false
NYANYA_DISCORD_ALLOWED_CHANNEL_IDS=
NYANYA_DISCORD_ALLOWED_USER_IDS=
NYANYA_DISCORD_FILE_SHARE_CHANNEL_IDS=
NYANYA_DISCORD_FILE_SHARE_CHANNEL_NAMES=
NYANYA_DISCORD_ATTACHMENT_DIR=downloads/discord
NYANYA_DISCORD_ATTACHMENT_MAX_MB=50
NYANYA_DISCORD_ATTACHMENT_SEARCH_LIMIT=1000

# Local dashboard. Keep host as 127.0.0.1 unless you explicitly harden external access.
NYANYA_DASHBOARD_RECORDING_ENABLED=true
NYANYA_DASHBOARD_HOST=127.0.0.1
# Optional exact extra hostnames, never wildcards; all /v1 data also require a token.
NYANYA_DASHBOARD_ALLOWED_HOSTS=
NYANYA_DASHBOARD_PORT=8765
NYANYA_DASHBOARD_CONTROL_TOKEN_FILE=data/dashboard_control.token
NYANYA_DASHBOARD_DB_PATH=data/nyanya_dashboard.db
# Hourly local maintenance catches up completed KST months; gzip only.
# Disable before a maintenance/deployment investigation. CLI status is always read-only.
NYANYA_LOG_MAINTENANCE_ENABLED=true
NYANYA_DASHBOARD_CORS_ORIGINS=http://127.0.0.1,http://localhost
NYANYA_PHASE_CHECK_ENABLED=false
NYANYA_PHASE_CHECK_INTERVAL_SECONDS=21600
NYANYA_DASHBOARD_CONFIRMATION_CHANNEL_ID=

# Telegram bridge.
# If this token is empty, Telegram bridge features are unavailable until
# you configure the token and allowed chats/users later.
NYANYA_TELEGRAM_BOT_TOKEN=
NYANYA_TELEGRAM_ALLOWED_CHAT_IDS=
NYANYA_TELEGRAM_ALLOWED_USER_IDS=
