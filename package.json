{
  "name": "@hcscat-dev/nyanya-agent",
  "version": "0.3.0",
  "description": "TypeScript CLI and Python runtime package for NyaNya Agent.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcscat/nyanya-agent.git"
  },
  "bin": {
    "nyanya": "dist/bin/nyanya.js",
    "nyanya-agent": "dist/bin/nyanya-agent.js",
    "nyanyactl": "dist/bin/nyanyactl.js",
    "nyanya-discord": "dist/bin/nyanya-discord.js",
    "nyanya-telegram": "dist/bin/nyanya-telegram.js",
    "nyanya-dashboard": "dist/bin/nyanya-dashboard.js",
    "nyanya-memory-worker": "dist/bin/nyanya-memory-worker.js"
  },
  "files": [
    "dist/**/*.js",
    "cli/src/**/*.ts",
    "src/nyanya_agent/*.py",
    "src/nyanya_agent/dashboard_static/**/*",
    "config/nyanya.json",
    "config/user_workspaces.example.json",
    "docs/README.md",
    "docs/core_stabilization_20260910.md",
    "docs/p0_execution_20260912.md",
    "docs/test_catalog_ko.md",
    "docs/architecture_and_roadmap.md",
    "docs/architecture_diagnostic_20260826.md",
    "docs/copyright_review.md",
    "docs/execution_control_plane.md",
    "docs/external_dashboard_access.md",
    "docs/installation_and_distribution.md",
    "docs/local_control_plane_implementation.md",
    "docs/npm_release_resumption_guide.md",
    "docs/operations_guide.md",
    "docs/source_publication_policy.md",
    "docs/user_acceptance_tests_ko.md",
    "scripts/*.sh",
    "scripts/mark_dist_executable.js",
    "tests/*.py",
    "prompts/system.md",
    "prompts/agent_memory.md",
    "prompts/policy.md",
    "prompts/policy_technical.md",
    "prompts/policy_governance.md",
    "tsconfig.json",
    "README.md",
    "README.KO.md",
    "LICENSE",
    "packaging/README.md",
    "packaging/install/*.sh",
    "packaging/install/*.ps1",
    "packaging/homebrew/Formula/*.template",
    "packaging/launchd/*.template",
    "packaging/release/*.sh",
    "packaging/release/*.py",
    "packaging/release/*.txt",
    ".env.example",
    "pyproject.toml"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/mark_dist_executable.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "check": "npm run typecheck && python3 -m py_compile src/nyanya_agent/runtime_paths.py src/nyanya_agent/core.py src/nyanya_agent/bridge_common.py src/nyanya_agent/discord_bridge.py src/nyanya_agent/telegram_bridge.py src/nyanya_agent/manager.py src/nyanya_agent/dashboard_api.py src/nyanya_agent/dashboard_store.py src/nyanya_agent/execution_store.py src/nyanya_agent/adapter_runner.py src/nyanya_agent/execution_adapters.py src/nyanya_agent/execution_runtime.py"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "^5.9.3"
  }
}
